{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "kyntech-www",
	"main": "worker/index.ts",
	"compatibility_date": "2026-08-25",
	"compatibility_flags": ["nodejs_compat"],
	// Chave de topo herdável. Impede que o Worker fique público em kyntech-www.<subdominio>.workers.dev;
	// o acesso passa a ser só pelo custom domain configurado no dashboard.
	"workers_dev": false,
	// Também de topo. Persiste os logs do Worker no dashboard - é o único rastro de um envio
	// que falhe, já que o lead não é gravado em lugar nenhum.
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "./out",
		"binding": "ASSETS",
		"not_found_handling": "404-page",
		"run_worker_first": ["/api/*"]
	},
	"send_email": [
		{
			"name": "SEND_EMAIL",
			"destination_address": "kyntech.ck@gmail.com"
		}
	],
	"ratelimits": [
		{
			"name": "CONTACT_RATE_LIMIT",
			"namespace_id": "1001",
			"simple": {
				"limit": 5,
				"period": 60
			}
		}
	]
}
